{
  "name": "account-card",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:functions": "npm run test --prefix functions",
    "test:functions:emulator": "firebase emulators:exec --only firestore \"npm run test:integration --prefix functions\"",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules\"",
    "test:all": "npm run test:functions && npm run test:functions:emulator && npm run test:rules",
    "admin:reset-pilot-users": "tsc -p scripts/admin/tsconfig.json && node scripts/admin/dist/resetPilotUsers.js"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.18.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
