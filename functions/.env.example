# Firebase Functions — העתק ל-functions/.env לפיתוח מקומי / Emulator
#
# פרודקשן (מומלץ): קובץ functions/.env.<PROJECT_ID> (למשל .env.account-card-18e3a)
# עם APP_BASE_URL=https://<your-public-vercel-host>
# או ערך שמירה אחרי prompt ב-`firebase deploy --only functions`.
# אם לא מוגדר בפרודקשן, הקוד נופל ל-fallback מתועד (ראה appBaseUrl.ts) ומדווח warn בלוג.

# חייב להתאים לפורט של npm run dev (3000 / 3001 וכו')
APP_BASE_URL=http://localhost:3000
